# Environment: dev | production
ENV=production

# Allowed CORS origins — use * for dev only, never in production
# Comma-separated for multiple: https://app.example.com,https://admin.example.com
CORS_ORIGINS=https://app.example.com

# Max PDF upload size in bytes (default 10MB)
MAX_PDF_BYTES=10485760

# Local AI classifier (Ollama-compatible)
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2
AI_REQUEST_TIMEOUT=30
AI_CLASSIFY_CONCURRENCY=10
# Optional: override the full classification prompt (leave empty to auto-build from categories)
AI_CLASSIFY_SYSTEM_PROMPT=
# Optional: comma-separated list of categories
# AI_CLASSIFY_CATEGORIES=Food and Dining,Transport and Travel,Shopping and Retail,...
