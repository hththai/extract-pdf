# ── Ports ─────────────────────────────────────────────────────────────────────
API_PORT=8000
CLIENT_PORT=80

API_URL=http://xxx.xxx.x.x:8000

# ── Resource limits ────────────────────────────────────────────────────────────
API_CPU_LIMIT=0.5       # fractional cores e.g. 0.5 = half a core
API_MEM_LIMIT=512m      # supports m / g suffixes
CLIENT_CPU_LIMIT=0.1
CLIENT_MEM_LIMIT=32m
LOG_RETENTION_DAYS=30

# ── App ────────────────────────────────────────────────────────────────────────
ENV=production
CORS_ORIGINS=http://xxx.xxx.x.x        # comma-separated for multiple origins
MAX_PDF_BYTES=10485760

# ── AI classifier ──────────────────────────────────────────────────────────────
AI_BASE_URL=http://xxx.xxx.x.x:11434   # Ollama server URL
AI_MODEL=llama3.2                      # model name loaded in Ollama
AI_REQUEST_TIMEOUT=30
AI_CLASSIFY_CONCURRENCY=10             # concurrent requests to Ollama; tune up/down based on GPU
AI_CLASSIFY_SYSTEM_PROMPT=             # leave empty to auto-build from default categories
