# Ports
API_PORT=8000
CLIENT_PORT=80

# URL the browser uses to reach the API (TrueNAS IP or hostname)
API_URL=http://192.168.1.x:8000

# Resource limits (Docker deploy constraints)
API_CPU_LIMIT=0.5       # fractional cores  e.g. 0.5 = half a core
API_MEM_LIMIT=512m      # supports m / g suffixes

CLIENT_CPU_LIMIT=0.1
CLIENT_MEM_LIMIT=32m
